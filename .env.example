# Local demonstration values only. Copy values into your shell; Go does not autoload .env.
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:8080
BIND_ADDR=127.0.0.1
PORT=8080
DATABASE_URL=postgres://style:local_demo_only@127.0.0.1:54329/style_ease?sslmode=disable
TEST_DATABASE_URL=postgres://style:local_demo_only@127.0.0.1:54329/style_ease?sslmode=disable
# Production: require APP_ENV=production, HTTPS APP_ORIGIN and a host-provided secret DATABASE_URL.
