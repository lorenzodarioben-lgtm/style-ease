{
  "name": "style-ease",
  "version": "1.0.0",
  "private": true,
  "description": "A responsive front-end fashion storefront built with Vue, Vue Router, and Vite.",
  "type": "module",
  "homepage": "https://lorenzodarioben-lgtm.github.io/style-ease/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lorenzodarioben-lgtm/style-ease.git"
  },
  "bugs": {
    "url": "https://github.com/lorenzodarioben-lgtm/style-ease/issues"
  },
  "author": "Lorenzo Ben",
  "license": "MIT",
  "keywords": [
    "vue",
    "vite",
    "vue-router",
    "vitest",
    "eslint",
    "prettier",
    "github-actions",
    "github-pages",
    "storefront",
    "ecommerce",
    "responsive-design",
    "accessibility"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{css,html,js,json,md,mjs}\" .prettierrc",
    "format:check": "prettier --check \"**/*.{css,html,js,json,md,mjs}\" .prettierrc",
    "audit": "npm audit --audit-level=high",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "validate": "run-s format:check lint test:run build check:bundle"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "happy-dom": "^20.11.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
